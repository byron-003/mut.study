# ==================================
# MUT Study Hub - Environment Variables
# ==================================

# ==================================
# DATABASE CONFIGURATION
# ==================================
# PostgreSQL connection details
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mut_study_hub
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_SSL=false

# Alternative: Use DATABASE_URL instead of individual settings
# DATABASE_URL=postgresql://username:password@localhost:5432/mut_study_hub

# ==================================
# REDIS CONFIGURATION (Optional)
# ==================================
# Redis Cache - Provides 10-20x performance boost
# Leave commented out if not using Redis
# The app will work without Redis but with reduced performance

# Option 1: Single Redis URL (Recommended)
# REDIS_URL=redis://localhost:6379
# REDIS_URL=redis://default:password@your-redis-host:6379
# REDIS_URL=rediss://default:password@secure-redis-host:6379 (SSL/TLS)

# Option 2: Individual Redis settings (Alternative)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password
# REDIS_DB=0
# REDIS_TLS=false

# Redis Providers:
# - Upstash: https://upstash.com (10K cmds/day free)
# - Redis Cloud: https://redis.com/try-free (30MB free)
# - Render: Built-in Redis addon (25MB free)
# - Local: Docker or native installation
# See REDIS_SETUP.md for detailed instructions

# ==================================
# SERVER CONFIGURATION
# ==================================
PORT=5000
NODE_ENV=development

# ==================================
# JWT CONFIGURATION
# ==================================
# Generate a secure random string for production
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_secure_random_string_in_production
JWT_EXPIRES_IN=7d

# ==================================
# CLOUDINARY CONFIGURATION
# ==================================
# File storage service - Sign up at https://cloudinary.com (free tier available)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=mut_study_hub_docs

# ==================================
# FILE UPLOAD CONFIGURATION
# ==================================
# Maximum file size in bytes (default: 100MB)
MAX_FILE_SIZE=104857600

# ==================================
# CORS CONFIGURATION
# ==================================
# Frontend URLs allowed to make requests
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Production URLs (update when deploying)
# CLIENT_URL=https://mut-study.yourdomain.com
# ADMIN_URL=https://admin.yourdomain.com

# ==================================
# EMAIL CONFIGURATION (Brevo/Sendinblue)
# ==================================
# Email service - Sign up at https://www.brevo.com (free tier: 300 emails/day)
# Get credentials from:
# - SMTP: https://app.brevo.com/settings/keys/smtp
# - Sender: https://app.brevo.com/senders

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login@smtp-brevo.com
BREVO_SMTP_KEY=xsmtpsib-your_smtp_key_here

# Email sender configuration (must be verified in Brevo)
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=MUT Study Hub

# Note: For development without SMTP, emails will be logged to console
# For production, you MUST:
# 1. Register sender address in Brevo
# 2. Verify your domain (optional but recommended)
# 3. Set valid SMTP credentials

# ==================================
# GEMINI AI CONFIGURATION (Optional)
# ==================================
# Google Gemini AI for document summaries
# Get API key from: https://aistudio.google.com/app/apikey
# Free tier: 60 requests/minute

GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model selection
# Options: gemini-pro, gemini-1.5-pro, gemini-1.5-flash, gemini-1.5-flash-8b
# Default: gemini-1.5-flash (best balance of speed and quality)
GEMINI_MODEL=gemini-1.5-flash

# ==================================
# RATE LIMITING (Optional)
# ==================================
# Override default rate limits if needed
# API_RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
# API_RATE_LIMIT_MAX_REQUESTS=1000 # 1000 requests per window

# ==================================
# PERFORMANCE TUNING (Optional)
# ==================================
# Database connection pool size (auto-calculated if not set)
# MAX_POOL_SIZE=50

# ==================================
# MONITORING & LOGGING (Optional)
# ==================================
# Enable detailed query logging (development only)
# LOG_QUERIES=true

# Sentry error tracking (for production monitoring)
# SENTRY_DSN=https://your_sentry_dsn_here

# ==================================
# SECURITY (Production Only)
# ==================================
# Enable these security features in production
# HELMET_ENABLED=true
# ENABLE_CORS_CREDENTIALS=true
# TRUST_PROXY=true

# ==================================
# NOTES
# ==================================
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env to version control (already in .gitignore)
# 3. Use different values for development, staging, and production
# 4. Generate secure random strings for JWT_SECRET in production
# 5. See documentation for detailed setup instructions:
#    - REDIS_SETUP.md for Redis configuration
#    - SCALING_STRATEGY.md for production deployment
#    - IMPLEMENTATION_GUIDE.md for step-by-step setup
