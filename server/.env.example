# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/mut_study_hub
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mut_study_hub
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSL=false  # Set to true for remote databases (Aiven, AWS RDS, etc.)

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=mut_study_hub_docs

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB in bytes (10 * 1024 * 1024)

# CORS Configuration
CLIENT_URL=http://localhost:5173
